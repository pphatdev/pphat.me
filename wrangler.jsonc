{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pphat",
  "pages_build_output_dir": ".open-next/assets",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"]
  // _worker.js/ is pre-bundled with wrangler 4 by scripts/pages-postbuild.mjs.
  // Pages' Git build ignores `no_bundle` and re-compiles it with wrangler 3
  // anyway; the loader in _worker.js/index.js keeps that pass away from the
  // real worker (_worker.js/app.js).
}
