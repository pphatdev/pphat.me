NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Must point at the API itself (local: `wrangler dev` on http://localhost:8787),
# NOT the admin app's /v1/api proxy: that proxy drops User-Agent, so the
# browser's view-count request is treated as a bot and never counted.
NEXT_PUBLIC_APP_API="https://api.example.com"

# Upstream API auth (required at build time for static generation of /api/* routes)
NEXT_PPHAT_API_KEY=

# Resend email (used by contact form)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Contact Form <onboarding@resend.dev>"

# Gmail configuration (alternative email path)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=